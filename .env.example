# PostgreSQL Verbindung
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_suite?schema=public"

# Session Secret (für Cookie-Signierung) - in Produktion zufällig generieren!
AUTH_SECRET="change-me-to-a-long-random-string"

# Standard Admin (nur für Seed)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# E-Mail (Nachbestell-Aufforderungen via Resend) - optional
# Ohne RESEND_API_KEY werden Mails nur geloggt, nicht versendet.
RESEND_API_KEY=""
MAIL_FROM="BusinessSuite <onboarding@resend.dev>"

# API-Zugang für externe Systeme (Claude-Cowork-Chat, Skripte) - optional.
# Ohne BS_API_TOKEN ist der Zugang komplett AUS. Mindestens 24 Zeichen,
# erzeugen z. B. mit: openssl rand -base64 32
BS_API_TOKEN=""
# Rolle des Zugangs: ADMIN | SALES | MARKETING | WAREHOUSE | ACCOUNTING
BS_API_ROLE="ADMIN"
# "true" = nur lesende Zugriffe erlaubt
BS_API_READONLY="false"
# Konto, dem Änderungen zugeschrieben werden (sonst erster aktiver Admin)
BS_API_USER_EMAIL=""
# "true" = Schlüssel zusätzlich als URL-Parameter (?api_key=...) erlauben -
# nur für Werkzeuge nötig, die keine eigenen Kopfzeilen setzen können.
# Ist dann IMMER nur lesend, unabhängig von BS_API_READONLY (URLs landen in
# Logs/Verläufen). Standard: aus.
BS_API_ALLOW_QUERY_TOKEN="false"
